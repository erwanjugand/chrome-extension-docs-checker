{
  "name": "chrome-extension-docs-checker",
  "packageManager": "pnpm@12.3.4",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.3.0"
  },
  "scripts": {
    "scrap": "node scrap.ts",
    "check:prettier": "prettier --check .",
    "check:lint": "oxlint",
    "check:ts": "tsc --noEmit",
    "check:all": "pnpm check:prettier && pnpm check:lint && pnpm check:ts",
    "fix:prettier": "prettier --log-level warn --write .",
    "fix:lint": "pnpm check:lint --fix --fix-suggestions",
    "fix:all": "pnpm fix:prettier && pnpm fix:lint"
  },
  "devDependencies": {
    "@erwanjugand/prettier-config": "1.1.1",
    "@prettier/plugin-oxc": "0.2.2",
    "@types/node": "24.13.3",
    "cheerio": "1.2.0",
    "oxlint": "1.81.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  }
}
