{
  "compilerOptions": {
    /* Base Options: */
    "skipLibCheck": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["node"],

    /* Strictness */
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    /* If your code doesn't run in the DOM: */
    "lib": ["es2022"]
  }
}
